# ===========================================
# 管理画面の Basic 認証（テスト運用フェーズ以降は必須）
# ===========================================
# /admin と /stylist を保護する。両方セットしたときだけ有効。
# 未設定なら素通し（ローカル開発・モック環境用）。
ADMIN_BASIC_USER=
ADMIN_BASIC_PASSWORD=

# ===========================================
# Supabase（必須）
# ===========================================
# https://supabase.com で無料プロジェクトを作成 → Project Settings → API から取得
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ===========================================
# サロンボード連携ドライバ: mock | csv | rpa | api
# 既定 (mock) は Supabase 内のテーブルにモック予約を書き込む
# ===========================================
SALONBOARD_DRIVER=mock

# RPA を使う場合（将来）
SALONBOARD_LOGIN_ID=
SALONBOARD_LOGIN_PASSWORD=

# 公式 API を得た場合（将来）
SALONBOARD_API_BASE_URL=
SALONBOARD_API_KEY=

# ===========================================
# LINE Messaging API（将来）
# ===========================================
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ===========================================
# Instagram 投稿取得
# ===========================================
# ドライバ: mock | apify
# 未指定の場合: APIFY_API_TOKEN があれば apify、無ければ mock を自動選択
INSTAGRAM_FETCHER=

# Apify Instagram Scraper を使う場合（推奨・実投稿取得）:
# 1. https://apify.com でサインアップ
# 2. Settings → Integrations → API tokens → Create new token
# 3. ここに貼り付け
APIFY_API_TOKEN=

# ===========================================
# Google Search Console の所有権確認（任意）
# ===========================================
# 「HTML タグ」方式で表示される content="..." の中身だけを入れる
GOOGLE_SITE_VERIFICATION=

# ===========================================
# 記事の自動執筆（scripts/articles/*）
# ===========================================
# 下書きは「本番サイトと同じ DB」に保存するため、スクリプトは
# .env.local ではなく .env.production.local を読む。
# Vercel の Environment Variables にある次の 2 つを、そのファイルに書く:
#   NEXT_PUBLIC_SUPABASE_URL=
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=
# （.env.production.local は Git に含まれない）

# ===========================================
# 記事の自動化（scripts/articles/run.mjs / GitHub Actions）
# ===========================================
# ラッコキーワード API（マイページで発行）。キーワード候補の提案と記事化前の調査に使う
RAKKO_API_KEY=
# Claude API（https://console.anthropic.com で発行）。記事の執筆と企画案の作成に使う
ANTHROPIC_API_KEY=
# 使うモデル（省略時 claude-opus-5-5）と思考の深さ（low / medium / high / xhigh / max。省略時 high）
ARTICLE_MODEL=
ARTICLE_EFFORT=

# ===========================================
# SNS 投稿の画像生成（scripts/social/*）
# ===========================================
# 画像 API のキーはサーバー（Vercel）には不要。.env.production.local（Claude Code 経路）か
# GitHub Secrets（無人経路）に置く。
# Gemini（推奨。https://aistudio.google.com で API キーを発行）
GEMINI_API_KEY=
# OpenAI を使う場合（組織の本人確認が必要）
OPENAI_API_KEY=
# どちらを使うか（gemini / openai。省略時はキーがある方。両方あれば gemini）
SOCIAL_IMAGE_PROVIDER=
# モデル名の上書き（省略時 gemini-2.5-flash-image / gpt-image-1）
GEMINI_IMAGE_MODEL=
OPENAI_IMAGE_MODEL=

# ===========================================
# SNS の自動投稿（Instagram / Threads。Vercel に設定）
# ===========================================
# 連携トークンを暗号化して DB に保存するための鍵。32 文字以上のランダムな文字列
INTEGRATION_SECRET=
# 毎日のトークン自動更新（vercel.json の cron）用。ランダムな文字列
CRON_SECRET=
# 接続時に短期トークンを 60 日の長期トークンへ変換するためのシークレット（任意）
# Instagram: 「Instagram ログインによる API 設定」画面の Instagram app secret
INSTAGRAM_APP_SECRET=
# Threads: Threads ユースケースの設定にある Threads App Secret
THREADS_APP_SECRET=
